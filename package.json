{
  "name": "land-van-jan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-public-routes.mjs && node scripts/prepare-sites-build.mjs",
    "start": "node server.mjs",
    "preview": "vite preview",
    "test": "npm run test:backend && npm run test:frontend && npm run test:sites",
    "test:backend": "node --test tests/backend.test.mjs",
    "test:frontend": "node --test tests/frontend-contracts.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/assets.test.mjs tests/seo.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.4.3"
  }
}
