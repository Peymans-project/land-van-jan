# Server-side member authentication. Never commit a real .env file.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=land_van_jan
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Comma-separated bootstrap administrators. The matching email becomes admin on registration.
ADMIN_EMAILS=owner@example.com
NODE_ENV=production

# Stripe membership billing. Use Railway Variables (never client-side VITE_ variables).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# A recurring Stripe Price ID for the €5/month membership.
STRIPE_MEMBERSHIP_PRICE_ID=price_replace_me
# Public canonical origin, no trailing slash (e.g. https://landvanjan.nl).
APP_BASE_URL=https://example.com
