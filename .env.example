# Server-side member authentication. Never commit a real .env file.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=land_van_jan
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# First-admin bootstrap only:
# 1) leave this empty, 2) register the owner account, 3) set that exact email,
# 4) restart once. Registration itself never grants admin.
ADMIN_EMAILS=
NODE_ENV=production

# Optional build-time SEO origin. When omitted, canonical tags, robots.txt, and
# sitemap.xml use https://land-van-jan-production.up.railway.app.
PUBLIC_ORIGIN=https://land-van-jan-production.up.railway.app

# The only Stripe value the owner supplies. The server provisions and stores the
# Product, €5/month Price, portal configuration, endpoint, and signing secret.
# Use a new Railway Variable; never a client-side VITE_ variable.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional runtime base URL for Stripe redirects/webhooks when Railway does not
# expose RAILWAY_PUBLIC_DOMAIN. Keep it aligned with PUBLIC_ORIGIN in production.
APP_BASE_URL=https://example.com

# Peymail transactionele e-mail. Maak in Peymail een eigen live client voor
# Land van Jan; deze waarden zijn uitsluitend voor Railway, nooit voor Vite.
TRANSACTIONAL_EMAIL_API_URL=https://web-production-7827a.up.railway.app/api/transactional-email/v1
TRANSACTIONAL_EMAIL_API_KEY=tx_live_replace_me
# Optional; defaults to contact@landvanjan.com when the Land van Jan sender is ready.
CONTACT_NOTIFICATION_EMAIL=contact@landvanjan.com
